{
  "name": "@shadow-lingo/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "ShadowLingo desktop app (Electron)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev:renderer": "vite",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir --publish never",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.65.1",
    "@shadow-lingo/core": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "jsdom": "^26.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "author": "Hoang Tu",
  "homepage": "https://github.com/hoangtularva/shadow-lingo"
}
