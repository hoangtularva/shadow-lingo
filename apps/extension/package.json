{
  "name": "@shadow-lingo/extension",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node ../../packages/core/scripts/fetch-ocr-data.mjs && wxt",
    "build": "node ../../packages/core/scripts/fetch-ocr-data.mjs && wxt build",
    "zip": "node ../../packages/core/scripts/fetch-ocr-data.mjs && wxt zip",
    "icons": "node scripts/build-icons.mjs",
    "test": "wxt prepare && vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@shadow-lingo/core": "workspace:*",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
